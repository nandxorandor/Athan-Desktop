<Window x:Class="AthanDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Athan" Height="500" Width="420"
        Background="{StaticResource Bg}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Border Background="{StaticResource HeaderGlow}" Height="150" VerticalAlignment="Top"/>

        <StackPanel Margin="24,26,24,20">
            <TextBlock Text="Athan" FontSize="30" FontWeight="Light"
                       Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
            <TextBlock Text="Offline prayer times and athan for Windows."
                       Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="Developed by Ahmed Khalaf (A.K.)" FontSize="14"/>

                    <TextBlock Text="CONTACT" Style="{StaticResource SectionHeading}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="EmailLink" Text="ahmedkhalaf1@yahoo.com" FontSize="14"
                               Foreground="{StaticResource Accent}" Cursor="Hand"
                               MouseLeftButtonUp="Email_Click"/>
                    <TextBlock x:Name="GithubLink" Text="github.com/nandxorandor" FontSize="14"
                               Foreground="{StaticResource Accent}" Cursor="Hand" Margin="0,8,0,0"
                               MouseLeftButtonUp="Github_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="PRIVACY" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Text="Nothing is collected and nothing is sent anywhere. Prayer times and the qibla are calculated on this PC from your coordinates, which are stored only in your own Windows profile."/>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextFaint}"
                               Text="Athan recordings are credited under Resources &amp; credits."/>
                </StackPanel>
            </Border>

            <Button Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
