<Window x:Class="AthanDesktop.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resources &amp; credits" Height="620" Width="470"
        Background="{StaticResource Bg}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="RESOURCES &amp; CREDITS" Style="{StaticResource SectionHeading}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="13"
                       Text="Where every athan included in this app came from. Most were published by IslamWeb, which permits its material to be used for non-commercial purposes as long as the source is named. This app is free, carries no ads, and sells nothing."/>
            <TextBlock x:Name="FatwaLink" Margin="0,8,0,0" FontSize="13" Cursor="Hand"
                       Foreground="{StaticResource Accent}"
                       Text="IslamWeb permission — fatwa no. 379009"
                       MouseLeftButtonUp="Fatwa_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel x:Name="CreditsList"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="SOFTWARE" Style="{StaticResource SectionHeading}"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="13"
                       Text="Prayer times are calculated with the open-source “adhan” library by Batoul Apps. Audio playback uses NAudio. Everything the app shows — prayer times, the qibla, the athkar and the Ramadan calendar — is computed on this PC and collects no data. The temperature is the only exception, and it can be switched off."/>
            <TextBlock Text="WEATHER" Style="{StaticResource SectionHeading}" Margin="0,14,0,0"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="13"
                       Text="Temperature data by Open-Meteo.com, used under CC BY 4.0. Requested only while the temperature is switched on."/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</Window>
