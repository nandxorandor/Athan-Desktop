<Window x:Class="AthanDesktop.LocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set location" Height="600" Width="430"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Dim}" TextWrapping="Wrap"
                   Text="Prayer times are worked out from your coordinates, on this computer."/>

        <!-- The answer for anywhere the bundled list does not reach, which is
             most of the world. Asks Windows, not a web service. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12">
            <StackPanel>
                <Button x:Name="DetectButton" Style="{StaticResource PrimaryButton}"
                        Content="Detect my location" Click="Detect_Click"
                        HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="DetectStatus" Style="{StaticResource Dim}" TextWrapping="Wrap"
                           Margin="0,9,0,0"
                           Text="Asks Windows where this PC is. Location must be turned on in Windows Settings → Privacy → Location."/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="OR PICK A CITY" Style="{StaticResource SectionHeading}" Margin="0,18,0,8"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" x:Name="SearchBox" TextChanged="Search_Changed"/>
            <ListBox Grid.Row="1" x:Name="Results" Margin="0,8,0,0"
                     MouseDoubleClick="Results_DoubleClick"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="OR ENTER COORDINATES" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lat" VerticalAlignment="Center" Width="30" Style="{StaticResource Dim}"/>
                <TextBox x:Name="LatBox" Width="120"/>
                <TextBlock Text="Lon" VerticalAlignment="Center" Width="34" Margin="14,0,0,0" Style="{StaticResource Dim}"/>
                <TextBox x:Name="LonBox" Width="120"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
