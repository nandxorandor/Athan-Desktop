<Window x:Class="AthanDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="660" Width="440"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,64">
            <StackPanel Margin="22,18,22,10">

                <TextBlock Text="ATHAN SOUND" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Fajr" Style="{StaticResource Dim}"/>
                        <Button x:Name="FajrSoundButton" Style="{StaticResource RowButton}"
                                Click="FajrSound_Click" Margin="0,6,0,0"/>

                        <TextBlock Text="Other prayers" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <Button x:Name="OtherSoundButton" Style="{StaticResource RowButton}"
                                Click="OtherSound_Click" Margin="0,6,0,0"/>

                        <TextBlock x:Name="VolumeLabel" Style="{StaticResource Dim}" Margin="0,18,0,0"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" ValueChanged="Volume_Changed" Margin="0,6,0,0"/>

                        <CheckBox x:Name="DuaCheck" Margin="0,20,0,0"
                                  Content="Play the du'aa after the athan"
                                  Checked="Dua_Changed" Unchecked="Dua_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="دعاء بعد الأذان — starts a couple of seconds after the call ends. The athan and the du'aa count as one announcement, so the window stays until both are done."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="BEFORE THE PRAYER" Style="{StaticResource SectionHeading}" Margin="0,20,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ReminderCheck" Content="Show a heads-up before each prayer"
                                  Checked="Reminder_Changed" Unchecked="Reminder_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="A silent popup so you can finish what you are doing. It closes itself after ten seconds."/>

                        <TextBlock x:Name="ReminderMinutesLabel" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="ReminderMinutesBox" SelectionChanged="ReminderMinutes_Changed"
                                  Margin="0,6,0,0"/>
                        <Button Content="Show me what it looks like" Style="{StaticResource RowButton}"
                                Click="PreviewReminder_Click" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="CALCULATION" Style="{StaticResource SectionHeading}" Margin="0,20,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Method" Style="{StaticResource Dim}"/>
                        <ComboBox x:Name="MethodBox" SelectionChanged="Method_Changed" Margin="0,6,0,0"/>

                        <TextBlock Text="Asr method" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="MadhabBox" SelectionChanged="Madhab_Changed" Margin="0,6,0,0"/>

                        <TextBlock x:Name="AdjustLabel" Style="{StaticResource Dim}" Margin="0,18,0,0"/>
                        <Slider x:Name="AdjustSlider" Minimum="-120" Maximum="120" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Adjust_Changed" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="Shifts every prayer time. Use this when your local timetable differs from the calculation."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="WINDOWS" Style="{StaticResource SectionHeading}" Margin="0,20,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheck" Content="Start Athan when I sign in"
                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="Athan sits in the notification area, so prayers are called without you opening it. It keeps running there when you close the main window."/>
                        <CheckBox x:Name="ShowOnStartupCheck" Margin="30,14,0,0"
                                  Content="Show the Athan window when it starts"
                                  Checked="ShowOnStartup_Changed" Unchecked="ShowOnStartup_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="60,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="Untick to have Athan start quietly in the notification area, with no window on your desktop."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="RAMADAN" Style="{StaticResource SectionHeading}" Margin="0,20,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Content="Ramadan calendar…" Style="{StaticResource RowButton}"
                                Click="Ramadan_Click"/>
                        <TextBlock x:Name="RamadanWhen" Style="{StaticResource Dim}" Margin="2,8,0,0"
                                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"/>
                        <CheckBox x:Name="RamadanPromptCheck" Margin="0,14,0,0"
                                  Content="Offer this automatically each Ramadan"
                                  Checked="RamadanPrompt_Changed" Unchecked="RamadanPrompt_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="Asks once, in the fortnight before the first fast, whether you want the month's timetable. Dismissing it only silences that year."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeading}" Margin="0,20,0,10"/>
                <Border Style="{StaticResource Card}" Padding="18,10">
                    <StackPanel>
                        <Button Content="Resources &amp; credits" Style="{StaticResource RowButton}"
                                Click="Credits_Click"/>
                        <Button Content="About Athan" Style="{StaticResource RowButton}"
                                Click="About_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned, so Close never scrolls out of reach on a short window. -->
        <Border VerticalAlignment="Bottom" Background="{StaticResource Bg}" Padding="22,12">
            <Button Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100"/>
        </Border>
    </Grid>
</Window>
