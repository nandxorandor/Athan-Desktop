<Window x:Class="AthanDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="660" Width="440"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,64">
            <StackPanel Margin="22,18,22,10">

                <Expander x:Name="SecAthanSound" Header="ATHAN SOUND" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LblFajr" Style="{StaticResource Dim}"/>
                        <Button x:Name="FajrSoundButton" Style="{StaticResource RowButton}"
                                Click="FajrSound_Click" Margin="0,6,0,0"/>

                        <TextBlock x:Name="LblOtherPrayers" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <Button x:Name="OtherSoundButton" Style="{StaticResource RowButton}"
                                Click="OtherSound_Click" Margin="0,6,0,0"/>

                        <TextBlock x:Name="VolumeLabel" Style="{StaticResource Dim}" Margin="0,18,0,0"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" ValueChanged="Volume_Changed" Margin="0,6,0,0"/>

                        <CheckBox x:Name="DuaCheck" Margin="0,20,0,0"
                                  Checked="Dua_Changed" Unchecked="Dua_Changed"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"
                                   Text="دعاء بعد الأذان — starts a couple of seconds after the call ends. The athan and the du'aa count as one announcement, so the window stays until both are done."/>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecBeforePrayer" Header="BEFORE THE PRAYER" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ReminderCheck"
                                  Checked="Reminder_Changed" Unchecked="Reminder_Changed"/>
                        <TextBlock x:Name="ExpReminder" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"/>

                        <TextBlock x:Name="ReminderMinutesLabel" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="ReminderMinutesBox" SelectionChanged="ReminderMinutes_Changed"
                                  Margin="0,6,0,0"/>
                        <Button x:Name="ReminderPreviewLbl" Style="{StaticResource RowButton}"
                                Click="PreviewReminder_Click" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecCalculation" Header="CALCULATION" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LblMethod" Style="{StaticResource Dim}"/>
                        <ComboBox x:Name="MethodBox" SelectionChanged="Method_Changed" Margin="0,6,0,0"/>

                        <TextBlock x:Name="LblAsrMethod" Style="{StaticResource Dim}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="MadhabBox" SelectionChanged="Madhab_Changed" Margin="0,6,0,0"/>

                        <TextBlock x:Name="AdjustLabel" Style="{StaticResource Dim}" Margin="0,18,0,0"/>
                        <Slider x:Name="AdjustSlider" Minimum="-120" Maximum="120" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Adjust_Changed" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ExpAdjust" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecWindows" Header="WINDOWS" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheck"
                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        <TextBlock x:Name="ExpStartup" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"/>
                        <CheckBox x:Name="ShowOnStartupCheck" Margin="30,14,0,0"
                                  Checked="ShowOnStartup_Changed" Unchecked="ShowOnStartup_Changed"/>
                        <TextBlock x:Name="ExpShowWindow" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="60,6,0,0"
                                   Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecTemperature" Header="TEMPERATURE" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="WeatherCheck"
                                  Checked="Weather_Changed" Unchecked="Weather_Changed"/>
                        <!-- The whole privacy story next to the switch that
                             controls it, rather than buried in a policy. -->
                        <TextBlock x:Name="ExpTemperature" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton x:Name="UnitCelsius" GroupName="Units"
                                         Checked="Units_Changed" Margin="0,0,16,0"/>
                            <RadioButton x:Name="UnitFahrenheit" GroupName="Units"
                                         Checked="Units_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecRamadan" Header="RAMADAN" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button x:Name="RamadanOpenLbl" Style="{StaticResource RowButton}"
                                Click="Ramadan_Click"/>
                        <TextBlock x:Name="RamadanWhen" Style="{StaticResource Dim}" Margin="2,8,0,0"
                                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"/>
                        <CheckBox x:Name="RamadanPromptCheck" Margin="0,14,0,0"
                                  Checked="RamadanPrompt_Changed" Unchecked="RamadanPrompt_Changed"/>
                        <TextBlock x:Name="ExpRamadan" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,6,0,0"
                                   Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                </Border>
                </Expander>

                <Expander x:Name="SecAbout" Header="ABOUT" Style="{StaticResource Section}">
                <Border Style="{StaticResource Card}" Padding="18,10">
                    <StackPanel>
                        <Button x:Name="CreditsRowLbl" Style="{StaticResource RowButton}"
                                Click="Credits_Click"/>
                        <Button x:Name="AboutRowLbl" Style="{StaticResource RowButton}"
                                Click="About_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned, so Close never scrolls out of reach on a short window. -->
        <Border VerticalAlignment="Bottom" Background="{StaticResource Bg}" Padding="22,12">
            <Button x:Name="CloseBtn" Click="Close_Click" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100"/>
        </Border>
    </Grid>
</Window>
